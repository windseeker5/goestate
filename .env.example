# Copy this file to .env and fill in real values. .env is gitignored.

# Email + password for the first admin user, created automatically the
# first time `flask init-db` runs (only if the users table is empty).
# After that, manage users from the app at /app/users.
ADMIN_EMAIL=admin@example.com
LIQUIDATOR_PASSWORD=change-me

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite database file path (relative to project root).
DATABASE_PATH=instance/estate.db

# Port for the dev server when running `python app.py`.
FLASK_RUN_PORT=5001

# Bind host for the dev server (`python app.py`). Keep this on 127.0.0.1.
#
# `python app.py` runs with DEBUG=True, which enables the Werkzeug interactive
# debugger. On an uncaught exception that debugger shows the frame's local
# variables to whoever loaded the page — including the Authorization header
# built in app/llm.py with your LLM API key in it. Binding to 0.0.0.0 publishes
# that to everyone on your network.
#
# If you need the app reachable from other machines or a Docker reverse proxy,
# serve it with Gunicorn (DEBUG off) rather than opening up the dev server.
FLASK_RUN_HOST=127.0.0.1
