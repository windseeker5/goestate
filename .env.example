# Copy this file to .env and fill in real values. .env is gitignored.

# Email + password for the first admin user, created automatically the
# first time `flask init-db` runs (only if the users table is empty).
# After that, manage users from the app at /app/users.
ADMIN_EMAIL=admin@example.com
LIQUIDATOR_PASSWORD=change-me

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite database file path (relative to project root).
DATABASE_PATH=instance/estate.db

# Port for the dev server when running `python app.py`.
FLASK_RUN_PORT=5001
