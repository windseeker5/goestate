# Copy this file to .env and fill in real values. .env is gitignored.

# Email + password for the first admin user, created automatically the
# first time `flask init-db` runs (only if the users table is empty).
# After that, manage users from the app at /app/users.
ADMIN_EMAIL=admin@example.com
LIQUIDATOR_PASSWORD=change-me

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite database file path (relative to project root).
DATABASE_PATH=instance/estate.db

# Persistent cache dir for fastembed's ONNX model weights (~252MB). Optional,
# but recommended: fastembed otherwise defaults to a tempdir path, and on
# systems where /tmp is tmpfs (wiped on reboot) that forces a re-download
# from Hugging Face Hub on the next chat/embedding call. Point it at a
# stable directory in your home cache, e.g.:
# FASTEMBED_CACHE_PATH=/home/you/.cache/fastembed

# Port for the dev server when running `python app.py`.
FLASK_RUN_PORT=5001

# Bind host for the dev server (`python app.py`). Keep this on 127.0.0.1.
#
# `python app.py` runs with DEBUG=True, which enables the Werkzeug interactive
# debugger. On an uncaught exception that debugger shows the frame's local
# variables to whoever loaded the page — including the Authorization header
# built in app/llm.py with your LLM API key in it. Binding to 0.0.0.0 publishes
# that to everyone on your network.
#
# If you need the app reachable from other machines or a Docker reverse proxy,
# serve it with Gunicorn (DEBUG off) rather than opening up the dev server.
FLASK_RUN_HOST=127.0.0.1

# Web Push notifications (new asset/liability/document/event alerts to the
# installed PWA). Generate a keypair once with:
#   python -c "
#   from py_vapid import Vapid02
#   from py_vapid.utils import b64urlencode
#   from cryptography.hazmat.primitives import serialization
#   v = Vapid02(); v.generate_keys()
#   pub = v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
#   priv = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
#   print('VAPID_PUBLIC_KEY=' + b64urlencode(pub))
#   print('VAPID_PRIVATE_KEY=' + b64urlencode(priv))
#   "
# Leave unset to disable push notifications entirely (the UI just won't offer
# the "Enable notifications" toggle).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com
